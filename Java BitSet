import java.util.BitSet;
import java.util.Scanner;

public class Solution {

    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        int n = scan.nextInt();
        int m = scan.nextInt();

        BitSet b1 = new BitSet(n);
        BitSet b2 = new BitSet(n);

        BitSet[] bitsets = new BitSet[]{null, b1, b2};

        for (int i = 0; i < m; i++) {
            String op = scan.next();
            int arg1 = scan.nextInt();
            int arg2 = scan.nextInt();

            switch (op) {
                case "AND":
                    bitsets[arg1].and(bitsets[arg2]);
                    break;
                case "OR":
                    bitsets[arg1].or(bitsets[arg2]);
                    break;
                case "XOR":
                    bitsets[arg1].xor(bitsets[arg2]);
                    break;
                case "FLIP":
                    bitsets[arg1].flip(arg2);
                    break;
                case "SET":
                    bitsets[arg1].set(arg2);
                    break;
            }

            System.out.println(b1.cardinality() + " " + b2.cardinality());
        }

        scan.close();
    }
}
