import java.util.*;
import java.io.*;

class Solution {
    public static void main(String []argh) {
        Scanner in = new Scanner(System.in);
        int t = in.nextInt();
        
        for (int i = 0; i < t; i++) {
            int a = in.nextInt();
            int b = in.nextInt();
            int n = in.nextInt();
            
            int currentTerm = a;
            for (int j = 0; j < n; j++) {
                currentTerm += (1 << j) * b; // (1 << j) computes 2^j
                System.out.print(currentTerm + " ");
            }
            System.out.println();
        }
        in.close();
    }
}
