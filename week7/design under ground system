import java.util.*;

class UndergroundSystem{
    Map<Integer,String>station=new HashMap<>();
    Map<Integer,Integer>time=new HashMap<>();
    Map<String,long[]>data=new HashMap<>();

    public UndergroundSystem(){}

    public void checkIn(int id,String stationName,int t){
        station.put(id,stationName);
        time.put(id,t);
    }

    public void checkOut(int id,String stationName,int t){
        String start=station.get(id);
        int duration=t-time.get(id);
        String key=start+"#"+stationName;
        long[]a=data.getOrDefault(key,new long[2]);
        a[0]+=duration;
        a[1]++;
        data.put(key,a);
        station.remove(id);
        time.remove(id);
    }

    public double getAverageTime(String startStation,String endStation){
        long[]a=data.get(startStation+"#"+endStation);
        return (double)a[0]/a[1];
    }
}
