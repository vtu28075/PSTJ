import java.util.*;

public class test {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        Deque<Integer> deque = new ArrayDeque<>();
        Set<Integer> set = new HashSet<>();

        int n = in.nextInt();
        int m = in.nextInt();
        int maxUnique = 0;

        for (int i = 0; i < n; i++) {
            int num = in.nextInt();

            deque.add(num);
            set.add(num);

            if (deque.size() == m) {
                if (set.size() > maxUnique) {
                    maxUnique = set.size();
                }

                // If max possible unique elements reached, break early for optimization
                if (maxUnique == m) {
                    break;
                }

                int removed = deque.remove();
                if (!deque.contains(removed)) {
                    set.remove(removed);
                }
            }
        }

        System.out.println(maxUnique);
        in.close();
    }
}


